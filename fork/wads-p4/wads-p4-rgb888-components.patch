+// RGB888 is packed in B, G, R byte order, as LVGL and the P4 JPEG decoder use it.
+inline void blend888(uint8_t *p, uint16_t color, unsigned alpha) {
+  if (!alpha) return;
+  const unsigned a = alpha >= 255 ? 256 : alpha + 1, b = 256 - a;
+  const unsigned r = (color >> 11) & 31, g = (color >> 5) & 63, bl = color & 31;
+  const unsigned c[3] = {(bl * 255 + 15) / 31, (g * 255 + 31) / 63, (r * 255 + 15) / 31};
+  for (int i = 0; i < 3; ++i) p[i] = (p[i] * b + c[i] * a) >> 8;
+}
