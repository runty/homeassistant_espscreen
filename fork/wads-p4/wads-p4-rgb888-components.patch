+inline void mask_corners_rgb888(uint8_t *pixels, int stride, int width, int height, const Corner &c) {
+  const int r = std::min(c.radius, std::min(c.w, c.h) / 2);
+  if (!pixels || r <= 0) return;
+  const float edge = r + 0.5f;
+  for (int dy = 0; dy < r; ++dy) {
+    const float across = r - dy - 0.5f;
+    const int out = std::max(0, std::min(r, static_cast<int>(std::ceil(r - std::sqrt(edge * edge - across * across) - 0.5f))));
+    for (const int y : {c.y + dy, c.y + c.h - 1 - dy}) {
+      if (y < 0 || y >= height) continue;
+      for (int i = 0; i < out; ++i)
+        for (const int x : {c.x + i, c.x + c.w - 1 - i})
+          if (x >= 0 && x < width) {
+            auto *p = pixels + (static_cast<size_t>(y) * stride + x) * 3;
+            p[0] = ((c.ground & 31) * 255 + 15) / 31;
+            p[1] = (((c.ground >> 5) & 63) * 255 + 31) / 63;
+            p[2] = (((c.ground >> 11) & 31) * 255 + 15) / 31;
+          }
+    }
+  }
+}
